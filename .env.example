# Fresh access token from your OWN TTA session. Never commit or send it.
TTA_ACCESS_TOKEN=
# Refresh token from the same session (browser DevTools > Application > Local Storage > refreshToken).
# Used once as a seed; the bot rotates it and keeps the current one in state/tokens.json.
TTA_REFRESH_TOKEN=
TTA_BRANCH_ID=2f6601ba-e223-4d52-ba83-958385d5fd69
# UUIDs from the observed reservation POST; confirm these are the intended two players.
TTA_FIRST_PLAYER_ID=
TTA_SECOND_PLAYER_ID=
# Safety: only change to false after validating dry-run output and site rules.
DRY_RUN=true

# Slack incoming webhook for success/failure notifications (optional). Treat as a secret.
SLACK_WEBHOOK_URL=
